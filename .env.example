# ==============================================================
# SubShield configuration — copy this file to `.env` and fill in.
# Never commit your real `.env`.
# ==============================================================

# ── AI (Gemini, free tier) ────────────────────────────────────
# 1. Go to https://aistudio.google.com/apikey  (Google AI Studio)
# 2. "Create API key" in a Google Cloud project (or the default one).
# 3. Paste it here.
GEMINI_API_KEY=

# Model used for structured extraction AND the browser agent.
# Flash models are the free-tier friendly ones. NOTE: older flash names
# (e.g. gemini-2.5-flash) are retired for NEW accounts — if you get a 404
# like "no longer available", switch to the current name (gemini-3.x-flash).
GEMINI_MODEL=gemini-3.6-flash

# browser-use's Gemini integration reads GOOGLE_API_KEY.
# Set it to the same key as GEMINI_API_KEY above.
GOOGLE_API_KEY=

# ── AI backend selector ───────────────────────────────────────
# Which LLM powers extraction + the browser agent:
#   gemini = Google Gemini (needs GEMINI_API_KEY above)
#   nvidia = NVIDIA NIM, OpenAI-compatible (needs NVIDIA_API_KEY below)
# NVIDIA's free tier has far higher daily limits than Gemini's - handy when
# you hit Gemini's per-day cap. Free key (nvapi-...) at https://build.nvidia.com
LLM_PROVIDER=gemini

# NVIDIA (free key at https://build.nvidia.com -> pick a model -> Get API Key)
NVIDIA_API_KEY=
# Model id as shown on the NVIDIA model page (each model has its own free
# rate limits; the default below is a reliable tool-calling instruct model).
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Google Calendar (free OAuth) ──────────────────────────────
# OAuth "Desktop app" client file downloaded from Google Cloud
# Console → APIs & Services → Credentials. Saved next to main.py.
# See README "Google Calendar setup".
GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# Calendar to write events to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# How many days before the renewal date the reminder is scheduled.
REMINDER_DAYS_BEFORE=3

# ── Behavior ──────────────────────────────────────────────────
# If the model's extraction confidence is below this, SubShield
# stops and asks you to confirm/edit the fields (0.0 – 1.0).
CONFIDENCE_THRESHOLD=0.6

# Browser window: 0 = show the window (recommended), 1 = hidden.
BROWSER_HEADLESS=0

# Hardening: restrict the agent to the account's own domain (blocks navigation
# to other sites, guarding credentials against prompt-injection). Turn off if
# the service logs in via a separate auth domain.
LOCK_DOMAINS=0

# Safety net on agent length (one step = one model decision).
AGENT_MAX_STEPS=40
